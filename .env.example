# Copy to .env (gitignored) OR export inline for a single command. NEVER commit a real key.
#
#   cp .env.example .env   &&   $EDITOR .env      # then: set -a; source .env; set +a
#   — or — run one-off:    STRIPE_SECRET_KEY=sk_test_... node scripts/verify-charge.mjs
#
# Test key (sk_test_...) → automated $1 charge+refund proof, risk-free, repeatable.
# Live key (sk_live_...) → ONLY used to refund a real PaymentIntent id after a hosted-checkout
#                          purchase. The script refuses to fabricate a live charge (no raw card data).
STRIPE_SECRET_KEY=

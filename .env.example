# Copy to .env (gitignored) OR export inline for a single command. NEVER commit a real key.
#
#   cp .env.example .env   &&   $EDITOR .env      # then: set -a; source .env; set +a
#   — or — run one-off:    STRIPE_SECRET_KEY=sk_test_... node scripts/verify-charge.mjs
#
# Test key (sk_test_...) → automated $1 charge+refund proof, risk-free, repeatable.
# Live key (sk_live_...) → ONLY used to refund a real PaymentIntent id after a hosted-checkout
#                          purchase. The script refuses to fabricate a live charge (no raw card data).
STRIPE_SECRET_KEY=

# === DRO-5 tracking: server-side Conversions API credentials (SECRETS) ===
# Set these on the function host (Vercel → Project → Settings → Environment Variables).
# A platform's CAPI is active only when BOTH of its vars are set; otherwise it is skipped (safe).
# See TRACKING.md for how to obtain each and how to verify.

# Meta (Conversions API)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=        # while testing: routes to Events Manager → Test Events, not live reporting

# TikTok (Events API)
TIKTOK_PIXEL_ID=
TIKTOK_CAPI_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# Google Analytics 4 (Measurement Protocol)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GA4_DEBUG=                   # set to 1 to validate via the GA4 /debug endpoint instead of sending

# Restrict which origin may POST to /api/capi (default "*"; set to your store origin in production)
CAPI_ALLOW_ORIGIN=
